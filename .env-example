DATABASE_URL="database-url"

# Tempo em ms para simular o atraso de rede
SIMULATE_WAIT_IN_MS=valor

#TAMANHO MAXIMO PARA UPLOAD DE IMAGENS EM BYTES
NEXT_PUBLIC_IMAGE_UPLOAD_MAX_SIZE=size

#NOME DA PASTA ONDE AS IMAGENS SAO SALVAS
IMAGE_UPLOAD_DIRECTORY=dir

#URL COMPLETA DO SERVIDOR DE IMAGENS SEM BARRA FINAL
IMAGE_SERVER_URL="http://localhost:3000/uploads";


# Chave usada para assinar os tokens JWT
JWT_SECRET_KEY='suaSecretKeyAqui'

# Tempo para o login expirar (use o mesmo valor em seconds e string)
#EX: 3600 -> 1H, 600 -> 10M, 60 -> 1M, 86400 -> 1d
LOGIN_EXPIRATION_SECONDS=0000
LOGIN_EXPIRATION_STRING='0d'

#Nome do coockie usado para login
LOGIN_COOKIE_NAME='nomeDoSeuCookie'

# Nome de usuário - hash de senha em base64
LOGIN_USER='nomedousuario'
# use o arquivo src/utils/generate-hashed-password.ts para gerar seu hash de senha
LOGIN_PASS='aquiasuasenha'

#Permite ou nao login (0 = Não, 1 = Sim)
ALLOW_LOGIN=0
